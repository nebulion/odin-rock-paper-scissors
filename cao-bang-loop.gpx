<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Cao Bang Loop GPS Routes"
  xmlns="http://www.topografix.com/GPX/1/1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.topografix.com/GPX/1/1
    http://www.topografix.com/GPX/1/1/gpx.xsd">

  <metadata>
    <name>Cao Bang Loop - All Variations</name>
    <desc>Cao Bang Loop motorcycle routes in Cao Bang Province, northern Vietnam. Includes classic Ban Gioc loop, extended Pac Bo loop, and full combo variation.</desc>
    <keywords>Cao Bang, Vietnam, motorcycle, loop, Ban Gioc, Waterfall, Pac Bo, Thang Hen</keywords>
  </metadata>

  <!-- ============================================================ -->
  <!--  WAYPOINTS (shared across all variations)                    -->
  <!-- ============================================================ -->

  <wpt lat="22.6658" lon="106.2519">
    <name>Cao Bang City</name>
    <desc>Starting point. Provincial capital. Fuel, accommodation, permits. Market area near Bang Giang River.</desc>
    <sym>City</sym>
  </wpt>

  <wpt lat="22.7167" lon="106.3833">
    <name>Thang Hen Lake</name>
    <desc>Cluster of 36 interconnected karst lakes at elevation. Stunning scenery, often foggy in the mornings.</desc>
    <sym>Scenic Area</sym>
  </wpt>

  <wpt lat="22.7833" lon="106.5167">
    <name>Tra Linh Town</name>
    <desc>Small market town. Fuel stop. Known for its Sunday border market.</desc>
    <sym>Town</sym>
  </wpt>

  <wpt lat="22.8167" lon="106.6167">
    <name>Trung Khanh Town</name>
    <desc>Main town near Ban Gioc. Accommodation and food. Good base for the waterfall area.</desc>
    <sym>Town</sym>
  </wpt>

  <wpt lat="22.8492" lon="106.7078">
    <name>Ban Gioc Waterfall</name>
    <desc>One of Southeast Asia's largest waterfalls, straddling the Vietnam–China border. Bamboo raft rides available. Entry fee required.</desc>
    <sym>Waterfall</sym>
  </wpt>

  <wpt lat="22.8456" lon="106.6964">
    <name>Nguom Ngao Cave</name>
    <desc>Spectacular limestone cave ~3 km from Ban Gioc. ~2.5 km of illuminated passages. Entry fee required.</desc>
    <sym>Cave</sym>
  </wpt>

  <wpt lat="22.8300" lon="106.6500">
    <name>Phong Nam Valley</name>
    <desc>Scenic karst valley with rice paddies and ethnic minority villages between Trung Khanh and Ban Gioc.</desc>
    <sym>Scenic Area</sym>
  </wpt>

  <wpt lat="22.7500" lon="106.4833">
    <name>Quang Uyen Town</name>
    <desc>Small town. Fuel stop on eastern loop variation.</desc>
    <sym>Town</sym>
  </wpt>

  <wpt lat="22.8869" lon="105.8708">
    <name>Pac Bo Cave (Karl Marx Cave)</name>
    <desc>Historic cave where Ho Chi Minh lived in 1941. Lenin Stream and Karl Marx Mountain nearby. Museum on site.</desc>
    <sym>Historic Site</sym>
  </wpt>

  <wpt lat="22.8750" lon="105.8800">
    <name>Lenin Stream (Suoi Lenin)</name>
    <desc>Stream beside Pac Bo where Ho Chi Minh fished. Part of the Pac Bo revolutionary site complex.</desc>
    <sym>Scenic Area</sym>
  </wpt>

  <wpt lat="22.8667" lon="105.9500">
    <name>Ha Quang Town</name>
    <desc>Town on the road between Cao Bang and Pac Bo / Ha Giang direction. Fuel available.</desc>
    <sym>Town</sym>
  </wpt>

  <wpt lat="22.5333" lon="105.8667">
    <name>Phia Oac - Phia Den National Park</name>
    <desc>Remote national park with old French hill station ruins. Cloud forest, waterfalls, good birdwatching.</desc>
    <sym>Park</sym>
  </wpt>

  <wpt lat="22.6000" lon="105.9500">
    <name>Nguyen Binh Town</name>
    <desc>Quiet mountain town near Phia Oac. Good overnight stop for the southern variation.</desc>
    <sym>Town</sym>
  </wpt>

  <wpt lat="22.6833" lon="106.1500">
    <name>Hoa Thuan Valley</name>
    <desc>Scenic valley approach to Cao Bang from the west. Karst scenery along the Bang Giang River.</desc>
    <sym>Scenic Area</sym>
  </wpt>

  <wpt lat="22.9167" lon="106.0333">
    <name>Nuong Biet Waterfall</name>
    <desc>Remote waterfall accessible on a detour north of Ha Quang. Rarely visited.</desc>
    <sym>Waterfall</sym>
  </wpt>

  <wpt lat="22.7667" lon="106.2667">
    <name>Cao Bang Viewpoint (QL3 ridge)</name>
    <desc>Panoramic viewpoint over Cao Bang valley on the QL3 highway approaching from the south.</desc>
    <sym>Scenic Area</sym>
  </wpt>

  <!-- ============================================================ -->
  <!--  ROUTE 1: Classic Ban Gioc Loop (2–3 days)                   -->
  <!--  Cao Bang → Thang Hen → Ban Gioc → Nguom Ngao               -->
  <!--  → Trung Khanh → Cao Bang                                   -->
  <!-- ============================================================ -->
  <rte>
    <name>CAO BANG - Classic Ban Gioc Loop</name>
    <desc>The most popular route. ~220 km loop. Northeast of Cao Bang through karst highlands to Ban Gioc Waterfall and Nguom Ngao Cave, returning via Trung Khanh. 2–3 days recommended.</desc>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
    <rtept lat="22.7167" lon="106.3833"><name>Thang Hen Lake</name></rtept>
    <rtept lat="22.7833" lon="106.5167"><name>Tra Linh Town</name></rtept>
    <rtept lat="22.8167" lon="106.6167"><name>Trung Khanh Town</name></rtept>
    <rtept lat="22.8300" lon="106.6500"><name>Phong Nam Valley</name></rtept>
    <rtept lat="22.8492" lon="106.7078"><name>Ban Gioc Waterfall</name></rtept>
    <rtept lat="22.8456" lon="106.6964"><name>Nguom Ngao Cave</name></rtept>
    <rtept lat="22.8167" lon="106.6167"><name>Trung Khanh Town (return)</name></rtept>
    <rtept lat="22.7500" lon="106.4833"><name>Quang Uyen Town</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
  </rte>

  <!-- ============================================================ -->
  <!--  ROUTE 2: Extended Pac Bo Loop (3–4 days)                    -->
  <!--  Adds the western Pac Bo / Ha Quang circuit                  -->
  <!-- ============================================================ -->
  <rte>
    <name>CAO BANG - Extended Pac Bo Loop</name>
    <desc>Adds the historic Pac Bo revolutionary site west of Cao Bang. ~320 km total. Combine Ban Gioc in the east with Pac Bo in the west for a full 3–4 day trip.</desc>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
    <rtept lat="22.8667" lon="105.9500"><name>Ha Quang Town</name></rtept>
    <rtept lat="22.8869" lon="105.8708"><name>Pac Bo Cave</name></rtept>
    <rtept lat="22.8750" lon="105.8800"><name>Lenin Stream</name></rtept>
    <rtept lat="22.8667" lon="105.9500"><name>Ha Quang Town (return)</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
    <rtept lat="22.7167" lon="106.3833"><name>Thang Hen Lake</name></rtept>
    <rtept lat="22.7833" lon="106.5167"><name>Tra Linh Town</name></rtept>
    <rtept lat="22.8167" lon="106.6167"><name>Trung Khanh Town</name></rtept>
    <rtept lat="22.8492" lon="106.7078"><name>Ban Gioc Waterfall</name></rtept>
    <rtept lat="22.8456" lon="106.6964"><name>Nguom Ngao Cave</name></rtept>
    <rtept lat="22.7500" lon="106.4833"><name>Quang Uyen Town</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
  </rte>

  <!-- ============================================================ -->
  <!--  ROUTE 3: Southern Phia Oac Variation (3–4 days)             -->
  <!--  Approaches or departs Cao Bang via Nguyen Binh              -->
  <!--  and the Phia Oac – Phia Den National Park                   -->
  <!-- ============================================================ -->
  <rte>
    <name>CAO BANG - Phia Oac Southern Variation</name>
    <desc>Approach Cao Bang from the south via Nguyen Binh and Phia Oac National Park (old French hill station). Combine with Ban Gioc loop for a figure-8 route. ~380 km. Best as entry/exit variation.</desc>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
    <rtept lat="22.6833" lon="106.1500"><name>Hoa Thuan Valley</name></rtept>
    <rtept lat="22.6000" lon="105.9500"><name>Nguyen Binh Town</name></rtept>
    <rtept lat="22.5333" lon="105.8667"><name>Phia Oac - Phia Den National Park</name></rtept>
    <rtept lat="22.6000" lon="105.9500"><name>Nguyen Binh Town (return)</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
    <rtept lat="22.7167" lon="106.3833"><name>Thang Hen Lake</name></rtept>
    <rtept lat="22.7833" lon="106.5167"><name>Tra Linh Town</name></rtept>
    <rtept lat="22.8167" lon="106.6167"><name>Trung Khanh Town</name></rtept>
    <rtept lat="22.8492" lon="106.7078"><name>Ban Gioc Waterfall</name></rtept>
    <rtept lat="22.8456" lon="106.6964"><name>Nguom Ngao Cave</name></rtept>
    <rtept lat="22.7500" lon="106.4833"><name>Quang Uyen Town</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
  </rte>

  <!-- ============================================================ -->
  <!--  ROUTE 4: Full Grand Loop (5–7 days)                         -->
  <!--  All highlights: Pac Bo + Thang Hen + Ban Gioc               -->
  <!--  + Nguom Ngao + Phia Oac                                     -->
  <!-- ============================================================ -->
  <rte>
    <name>CAO BANG - Full Grand Loop (All Highlights)</name>
    <desc>The complete Cao Bang experience. ~480 km covering Pac Bo, Thang Hen, Ban Gioc, Nguom Ngao Cave, and Phia Oac National Park. 5–7 days at a relaxed pace.</desc>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
    <rtept lat="22.8667" lon="105.9500"><name>Ha Quang Town</name></rtept>
    <rtept lat="22.8869" lon="105.8708"><name>Pac Bo Cave</name></rtept>
    <rtept lat="22.8750" lon="105.8800"><name>Lenin Stream</name></rtept>
    <rtept lat="22.8667" lon="105.9500"><name>Ha Quang Town</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
    <rtept lat="22.7667" lon="106.2667"><name>Cao Bang Viewpoint</name></rtept>
    <rtept lat="22.7167" lon="106.3833"><name>Thang Hen Lake</name></rtept>
    <rtept lat="22.7833" lon="106.5167"><name>Tra Linh Town</name></rtept>
    <rtept lat="22.8167" lon="106.6167"><name>Trung Khanh Town</name></rtept>
    <rtept lat="22.8300" lon="106.6500"><name>Phong Nam Valley</name></rtept>
    <rtept lat="22.8492" lon="106.7078"><name>Ban Gioc Waterfall</name></rtept>
    <rtept lat="22.8456" lon="106.6964"><name>Nguom Ngao Cave</name></rtept>
    <rtept lat="22.8167" lon="106.6167"><name>Trung Khanh Town</name></rtept>
    <rtept lat="22.7500" lon="106.4833"><name>Quang Uyen Town</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
    <rtept lat="22.6833" lon="106.1500"><name>Hoa Thuan Valley</name></rtept>
    <rtept lat="22.6000" lon="105.9500"><name>Nguyen Binh Town</name></rtept>
    <rtept lat="22.5333" lon="105.8667"><name>Phia Oac National Park</name></rtept>
    <rtept lat="22.6000" lon="105.9500"><name>Nguyen Binh Town</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City</name></rtept>
  </rte>

  <!-- ============================================================ -->
  <!--  ROUTE 5: Ha Giang to Cao Bang Connector                     -->
  <!--  Links the two loops for a mega northern Vietnam circuit      -->
  <!-- ============================================================ -->
  <rte>
    <name>CAO BANG - Ha Giang to Cao Bang Connector</name>
    <desc>Road connecting the end of the Ha Giang Loop to the start of the Cao Bang Loop. ~180 km via Bao Lac and Bao Lam. Spectacular and remote. Suitable for experienced riders only.</desc>
    <rtept lat="23.1667" lon="105.4167"><name>Meo Vac Town (Ha Giang Loop end)</name></rtept>
    <rtept lat="22.9500" lon="105.6667"><name>Bao Lac Town</name></rtept>
    <rtept lat="22.7833" lon="105.8667"><name>Bao Lam District</name></rtept>
    <rtept lat="22.6000" lon="105.9500"><name>Nguyen Binh Town</name></rtept>
    <rtept lat="22.6658" lon="106.2519"><name>Cao Bang City (Cao Bang Loop start)</name></rtept>
  </rte>

</gpx>
